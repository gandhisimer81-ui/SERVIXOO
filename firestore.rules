rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile: only the authenticated user can access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Assessments subcollection: only the user can read and write their own assessment history
      match /assessments/{assessmentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
